# Local staging copy of the geodata sources — not the copies the app builds from.
/data/

# Generated climate rasters (rebuild: ./scripts/build_all.sh). Excluded by
# content rather than by directory: an ignored *directory* is never descended
# into, so the !negations below would not work.
app/public/data/*
!app/public/data/*.fgb
