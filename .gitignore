data.raw/
.mypy_cache/

# Generated climate rasters (rebuild: ./scripts/build_all.sh). Excluded by
# content rather than by directory: an ignored *directory* is never descended
# into, so the !negations below would not work.
app/public/data/*
!app/public/data/*.fgb

# Internal documentation lives in the private companion repository M590-doc
# (tester correspondence, the DWA-M 590 Gelbdruck draft and the specs quoting
# it). Clone it here:
#   git clone git@github.com:ATB-Potsdam/M590-doc.git app/doc
# Nothing from it may be committed to this public repository.
app/doc/

# Raster build cache. build_raster_nc.py streams ~12 GB of daily FAO-56 NetCDF
# through here; only the aggregated output under app/public/data/ is committed.
.rastercache/
scripts/.venv/
