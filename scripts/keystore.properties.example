# Example for app/android/keystore.properties — the optional, gitignored file
# holding the upload-key passwords so scripts/buildAndroid.sh does not prompt.
#
# Install it (from the repository root):
#
#     cp scripts/keystore.properties.example app/android/keystore.properties
#     chmod 600 app/android/keystore.properties
#     $EDITOR app/android/keystore.properties
#
# The build refuses to read the file unless it is restricted to your user; a
# world- or group-readable copy aborts with a chmod hint rather than being used.
#
# It is sourced by the shell, so only plain assignments belong here — no export,
# no spaces around "=", and quote anything containing shell metacharacters.
# The environment takes precedence, so an inline M590_KEYSTORE_PASSWORD=... on a
# single build still overrides whatever is stored here.
#
# Never commit the real file. app/android/.gitignore already excludes it, along
# with *.jks and *.keystore.

M590_KEYSTORE_PASSWORD=change-me

# Omit or leave empty when the key uses the same password as the keystore, which
# is the case for the key created by scripts/createUploadKeystore.sh.
#M590_KEY_PASSWORD=change-me
