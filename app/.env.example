# Template for app/.env.local — copy it, then fill in the real values:
#
#     cp app/.env.example app/.env.local
#     chmod 600 app/.env.local
#     $EDITOR app/.env.local
#
# .env.local is excluded by app/.gitignore (.env.*) and is the ONLY place for
# secrets. Do not put them in app/.env: that file is tracked, and this
# repository is public. Values here are dummies — never real credentials.
#
# Plain key=value lines, no "export", no spaces around "=". The corresponding
# environment variable always overrides the file, so a one-off
# `M590_KEYSTORE_PASSWORD=... ./gradlew bundleRelease` works without editing.

# --- Android release signing (read by android/app/build.gradle) --------------
# Absolute path: Gradle resolves a relative one against android/app/, not the
# repository root. With M590_KEYSTORE unset the release build stays unsigned
# instead of failing, so machines without the upload key can still build. With
# it set, a missing password or alias is a hard error rather than a silently
# unsigned artifact that only Play would reject.
M590_KEYSTORE=/absolute/path/to/upload-keystore.jks
M590_KEYSTORE_PASSWORD=change-me
M590_KEY_ALIAS=change-me
# Optional: defaults to M590_KEYSTORE_PASSWORD, which is what
# scripts/createUploadKeystore.sh produces.
M590_KEY_PASSWORD=

# --- Web build ---------------------------------------------------------------
# Committed defaults live in app/.env; uncomment here only to override locally.
# Anything prefixed VITE_ is inlined into the browser bundle and therefore
# public — never put a secret behind that prefix.
#VITE_BASE_PATH=/
#VITE_APP_URL=http://localhost:5174/

# --- Google Play publishing (read by scripts/deployAndroid.sh) --------------
# Service account JSON with "Release manager" rights in the Play Console,
# downloaded from Google Cloud IAM and invited in Play Console → Users.
# Absolute path; keep the file itself outside the repository.
M590_PLAY_SERVICE_ACCOUNT=/absolute/path/to/play-service-account.json
M590_PLAY_PACKAGE=de.runlevel3.m590
